<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ptz.Gateway.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <MyType>Empty</MyType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.31" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ptz.Gateway\Ptz.Gateway.vbproj" />
    <ProjectReference Include="..\..\src\Ptz.Presentation\Ptz.Presentation.vbproj" />
    <ProjectReference Include="..\..\src\Ptz.Core\Ptz.Core.vbproj" />
    <Compile Include="..\Ptz.Tests\TestSupport.vb" Link="TestSupport.vb" />
  </ItemGroup>
</Project>
