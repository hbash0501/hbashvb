<Project Sdk="Microsoft.NET.Sdk">
  <!-- يبني التطبيق المكتبي الكامل مقابل مراجع .NET Framework 4.8 على أي نظام (بما فيه Linux) مع معاملة التحذيرات كأخطاء.
       ناتجه ملف تشغيل Windows مع مكتباته؛ يجمعه tools/build-windows-package.sh في حزمة جاهزة.
       البناء على Windows عبر Visual Studio يبقى متاحاً بـ BUILD_AND_VALIDATE_AR.ps1. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>AIDocumentArchiveVB</RootNamespace>
    <AssemblyName>AIDocumentArchiveVB</AssemblyName>
    <StartupObject>AIDocumentArchiveVB.Program</StartupObject>
    <MyType>WindowsForms</MyType>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionExplicit>On</OptionExplicit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42353,42354,42355</NoWarn>
    <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>
    <ApplicationIcon>../../AIDocumentArchiveVB/Assets/basira.ico</ApplicationIcon>
    <ApplicationManifest>../../AIDocumentArchiveVB/app.manifest</ApplicationManifest>
    <AppConfig>../../AIDocumentArchiveVB/App.config</AppConfig>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Data" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Drawing" />
    <Import Include="System.Linq" />
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Xml.Linq" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Data" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="AForge"><HintPath>../../packages/AForge.2.2.5/lib/AForge.dll</HintPath></Reference>
    <Reference Include="AForge.Video"><HintPath>../../packages/AForge.Video.2.2.5/lib/AForge.Video.dll</HintPath></Reference>
    <Reference Include="AForge.Video.DirectShow"><HintPath>../../packages/AForge.Video.DirectShow.2.2.5/lib/AForge.Video.DirectShow.dll</HintPath></Reference>
    <Reference Include="System.Data.SQLite"><HintPath>../../packages/Stub.System.Data.SQLite.Core.NetFramework.1.0.118.0/lib/net46/System.Data.SQLite.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../AIDocumentArchiveVB/**/*.vb" Exclude="../../AIDocumentArchiveVB/bin/**;../../AIDocumentArchiveVB/obj/**" />
  </ItemGroup>
  <Target Name="CopySQLiteInterop" AfterTargets="Build">
    <Copy SourceFiles="../../packages/Stub.System.Data.SQLite.Core.NetFramework.1.0.118.0/build/net46/x86/SQLite.Interop.dll" DestinationFolder="$(OutDir)x86" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../packages/Stub.System.Data.SQLite.Core.NetFramework.1.0.118.0/build/net46/x64/SQLite.Interop.dll" DestinationFolder="$(OutDir)x64" SkipUnchangedFiles="true" />
  </Target>
</Project>
