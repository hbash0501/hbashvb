<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><RootNamespace>AIDocumentArchiveVB</RootNamespace><OptionStrict>On</OptionStrict><OptionInfer>On</OptionInfer><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
  <ItemGroup>
    <Compile Include="CoreTests.vb" />
    <Compile Include="../AIDocumentArchiveVB/Services/BasiraDates.vb" Link="BasiraDates.vb" />
