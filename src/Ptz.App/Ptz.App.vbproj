<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Ptz.App</RootNamespace>
    <AssemblyName>PtzPlatform</AssemblyName>
    <StartupObject>Ptz.App.Program</StartupObject>
    <MyType>Empty</MyType>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ptz.Core\Ptz.Core.vbproj" />
    <ProjectReference Include="..\Ptz.Presentation\Ptz.Presentation.vbproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
