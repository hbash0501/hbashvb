<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- منصة بصيرة: خادم ASP.NET Core بقاعدة SQLite، وواجهة عربية مضمّنة في الملف التنفيذي. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Basira.Platform</RootNamespace>
    <AssemblyName>Basira</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <Version>3.6.0</Version>
    <Product>بصيرة</Product>
    <ApplicationIcon>../../AIDocumentArchiveVB/Assets/basira.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.31" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
  </ItemGroup>
  <ItemGroup>
    <!-- نماذج Tesseract الدقيقة (tessdata_best، رخصة Apache 2.0) بجوار الملف التنفيذي. -->
    <None Include="tessdata/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="wwwroot/**" />
    <EmbeddedResource Include="wwwroot/**" />
    <!-- قوالب قارئ الأرقام: مولّدة بـ tools/DigitTemplates من خطوط عربية مفتوحة (OFL). -->
    <EmbeddedResource Include="Processing/Ocr/digits.bin.gz" LogicalName="digits.bin.gz" />
    <!-- عينات مصنفة لمعايرة النموذج الدلالي وقياسه (أعدها فريق المنصة؛ ليست مراسلات حقيقية). -->
    <EmbeddedResource Include="Intelligence/Calibration/*.json" LogicalName="calibration/%(Filename)%(Extension)" />
    <!-- صفحات خطابات اصطناعية بعيوب مسح متدرجة ونصها الصحيح، لقياس محركات القراءة على جهاز المستخدم (tools/ocr-bench، البذرة 31415). -->
    <EmbeddedResource Include="Processing/Ocr/Samples/*" LogicalName="ocr-samples/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Basira.Core/Basira.Core.vbproj" />
  </ItemGroup>
</Project>
